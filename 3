    async def custom_precision_hybrid_search(
        self,
        query: str,
        top_k: int = 50
    ) -> List[Dict[str, Any]]:
        """
        Executes concurrent Vector and BM25 searches to retrieve raw scores,
        applies strict ID filtering, and performs custom mathematical reranking.
        """
        logger.info(f"Performing custom precision hybrid search for: {query[:100]}")
        import asyncio
        from azure.search.documents.models import VectorizedQuery
        
        odata_filter = build_strict_id_filter(query)

        # 1. Prepare Vector Task
        try:
            query_embedding = await asyncio.wait_for(
                self.embeddings.aembed_query(query),
                timeout=90.0
            )
            vector_query = VectorizedQuery(
                vector=query_embedding,
                k_nearest_neighbors=top_k,
                fields="content_vector"
            )
            vector_task = self.search_client.search(
                search_text=None,  
                vector_queries=[vector_query],
                select=["id", "filename", "section", "content", "summary", "page_number"],
                top=top_k
            )
        except Exception as e:
            logger.error(f"Embedding failed, proceeding with BM25 only: {e}")
            vector_task = None

        # 2. Prepare BM25 Text Task 
        text_task = self.search_client.search(
            search_text=query,
            filter=odata_filter,
            select=["id", "filename", "section", "content", "summary", "page_number", "metadata"],
            top=top_k
        )

        # 3. Execute Concurrently
        if vector_task:
            vector_results_gen, text_results_gen = await asyncio.gather(vector_task, text_task)
        else:
            vector_results_gen = []
            text_results_gen = await text_task

        # 4. Aggregate Candidates by Filename
        candidates = {}

        if vector_task:
            async for doc in vector_results_gen:
                fname = doc.get("filename")
                if not fname: continue
                if fname not in candidates:
                    candidates[fname] = {"vector_score": 0.0, "bm25_score": 0.0, "count": 0, "doc": doc}
                
                candidates[fname]["count"] += 1
                candidates[fname]["vector_score"] = max(candidates[fname]["vector_score"], doc.get("@search.score", 0.0))

        async for doc in text_results_gen:
            fname = doc.get("filename")
            if not fname: continue
            if fname not in candidates:
                candidates[fname] = {"vector_score": 0.0, "bm25_score": 0.0, "count": 0, "doc": doc}
            
            candidates[fname]["doc"] = doc 
            candidates[fname]["bm25_score"] = max(candidates[fname]["bm25_score"], doc.get("@search.score", 0.0))

        # 5. Apply the Clinical Reranking Math
        top_docs = rerank_azure_candidates(candidates)
        return top_docs
