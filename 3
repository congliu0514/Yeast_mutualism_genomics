import re
from typing import List, Dict, Any, Optional

ID_PATTERN = r'\b[A-Za-z0-9_-]\d{5,}[A-Za-z0-9_-]\b'

def extract_ids(query: str) -> List[str]:
    """Extract strong ID terms from the query."""
    return [m.lower() for m in re.findall(ID_PATTERN, query)]

def build_strict_id_filter(query: str) -> Optional[str]:
    """Creates an OData filter to strictly require ID presence in metadata."""
    extracted_ids = extract_ids(query)
    
    if not extracted_ids:
        return None  

    filter_clauses = []
    for doc_id in extracted_ids:
        clause = f"search.ismatch('{doc_id}', 'metadata/study_id, metadata/compound, metadata/clinical_trials_gov_id, metadata/ind_id, metadata/EU_CT_id')"
        filter_clauses.append(clause)
    
    return " and ".join(filter_clauses)

def rerank_azure_candidates(candidates: Dict[str, Any]) -> List[Dict[str, Any]]:
    """Normalizes raw Azure scores and applies custom clinical precision weights."""
    max_vec = max([c.get("vector_score", 0.0) for c in candidates.values()] + [0.0001])
    max_bm25 = max([c.get("bm25_score", 0.0) for c in candidates.values()] + [0.0001])

    ranked = []
    for fname, data in candidates.items():
        vec_norm = data.get("vector_score", 0.0) / max_vec 
        bm25_norm = data.get("bm25_score", 0.0) / max_bm25 
        count = data.get("count", 0)
        
        # Combined BM25 (Metadata 3.0 + Summary 2.5) = 5.5
        # Vector Semantic Similarity = 1.0 
        # Hit Count (Stability) = 0.1 
        final_score = (5.5 * bm25_norm) + (1.0 * vec_norm) + (0.1 * count)
        ranked.append((final_score, data["doc"]))

    ranked.sort(key=lambda x: x[0], reverse=True)
    return [d for score, d in ranked[:20]]
