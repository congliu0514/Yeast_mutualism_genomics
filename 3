import pickle

with open("/dbfs/rag_index/dpr_doc_map.pkl", "rb") as f:
    raw = pickle.load(f)
doc_map = {int(k): v for k, v in raw.items()}

# Build title set
all_titles = {v.get("title","").lower().strip() for v in doc_map.values()}

# Check specific missing titles with fuzzy search
missing = ['winner (band)', 'bordan tkachuk', 'brown county, kansas', 
           'in the realm of the hackers', 'masakazu katsura']

print("=== Exact match ===")
for t in missing:
    print(f"  '{t}': {'FOUND' if t in all_titles else 'MISSING'}")

print("\n=== Fuzzy (first word) ===")
for t in missing:
    first_word = t.split()[0]
    matches = [x for x in all_titles if first_word in x][:3]
    print(f"  '{t}' → {matches}")

print(f"\nTotal unique titles in doc_map: {len(all_titles):,}")
