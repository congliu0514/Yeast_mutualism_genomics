def lookup_page_number(filename: str, quote: str, raw_folder: str = None) -> int:
    """Robustly finds the page number by normalizing text."""
    if raw_folder is None:
        raw_folder = settings.DATA_FOLDER
    
    try:
        if not quote or not filename:
            return 1
            
        file_path = os.path.join(raw_folder, filename)
        
        if filename.endswith(".pdf"):
            pages = read_pdf_content(file_path)
        else:
            return 1 # DOCX defaults to 1

        if not isinstance(pages, list):
            return 1

        clean_quote = " ".join(quote.split()).lower()
        search_snippet = clean_quote[:50]

        for i, page_text in enumerate(pages):
            clean_page_text = " ".join(page_text.split()).lower()
            if search_snippet in clean_page_text:
                return i + 1 

        return 1
    except Exception as e:
        return 1

def assign_citation_numbers(out: FinalOutput) -> FinalOutput:
    """Assigns numbers and verifies hallucinated page numbers against the source."""
    for idx, cit in enumerate(out.citations, start=1):
        cit.number = idx
        # Overwrite LLM's guess with the verified lookup
        cit.page = lookup_page_number(cit.filename, cit.quote)
    return out
