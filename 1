import os, json

DATA_PATH = f"{ROOT}/data/hotpotqa_dev_fullwiki.json"

if os.path.exists(DATA_PATH):
    print(f"Already exists: {DATA_PATH}")
else:
    from datasets import load_dataset
    print("Downloading hotpot_qa fullwiki validation...")
    ds = load_dataset("hotpot_qa", "fullwiki", split="validation")
    
    records = []
    for ex in ds:
        records.append({
            "question": ex["question"],
            "answer": ex["answer"],
            "supporting_facts": list(zip(ex["supporting_facts"]["title"],
                                         ex["supporting_facts"]["sent_id"])),
            "type": ex["type"],
        })
    
    with open(DATA_PATH, "w") as f:
        json.dump(records, f)
    print(f"Saved {len(records)} questions to {DATA_PATH}")


