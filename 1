import json
from datasets import load_dataset

ds = load_dataset('hotpot_qa', 'fullwiki', split='validation')
data = []
for item in ds:
    data.append({
        'question': item['question'],
        'answer': item['answer'],
        'supporting_facts': list(zip(
            item['supporting_facts']['title'],
            item['supporting_facts']['sent_id']
        )),
    })
os.makedirs("data", exist_ok=True)
with open("data/hotpotqa_dev_fullwiki.json", "w") as f:
    json.dump(data, f)
print(f"Saved {len(data)} questions.")

