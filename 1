import os, subprocess

idx = "/dbfs/rag_index/dpr_flat.faiss"
log = "/dbfs/rag_index/build.log"

# Index progress
if os.path.exists(idx):
    gb = os.path.getsize(idx) / 1e9
    passages = int(gb * 1e9 / (768 * 4))
    pct = passages / 21_000_000 * 100
    print(f"Index: {gb:.2f} GB | {passages:,} / 21,000,000 passages ({pct:.1f}%)")
else:
    print("Index: not yet created")

# Last 15 lines of log
if os.path.exists(log):
    result = subprocess.run(["tail", "-15", log], capture_output=True, text=True)
    print(f"\n--- build.log (last 15 lines) ---\n{result.stdout}")
else:
    print("Log: not yet created")

# Check if process is still running
result2 = subprocess.run(["pgrep", "-f", "download_dpr_wiki"], capture_output=True, text=True)
if result2.stdout.strip():
    print(f"Process running (PID: {result2.stdout.strip()})")
else:
    print("Process: NOT running (finished or crashed)")


